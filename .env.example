# Copy to .env and fill in. Never commit the real .env.

# --- Traefik ---
# Email letsencrypt uses for certificate notices.
ACME_EMAIL=you@example.com

# Basic auth for the control-plane API (api.sparkdb.pro).
# Generate with:  htpasswd -nbB admin 'your-password'
# In docker-compose, every $ must be doubled ($ -> $$).
API_BASIC_AUTH=admin:$$2y$$05$$replace-with-your-own-bcrypt-hash

# --- Scale to zero ---
# Idle time before a database's compute is dropped.
IDLE_TIMEOUT=2m
# How often the reaper scans for idle databases.
REAP_INTERVAL=15s
# How long to wait for a woken container to accept connections.
WAKE_TIMEOUT=60s

# --- Running sparkdb outside compose (local dev) ---
# Inside compose these are set for you. Only needed when running the binary
# directly against a socket proxy you expose yourself.
# DOCKER_API_URL=http://localhost:2375
# DOCKER_NETWORK=sparkdb-network
# SQLITE_PATH=sparkdb.db
# PORT=:8080
# PG_LISTEN_ADDR=:5432
#
# Only when the Docker API sits behind basic auth. Both or neither.
# DOCKER_API_USERNAME=
# DOCKER_API_PASSWORD=
